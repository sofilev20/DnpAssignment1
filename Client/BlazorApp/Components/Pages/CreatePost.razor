@page "/posts/create"
@attribute [Authorize]
@using System.Security.Claims
@using BlazorApp.Services
@using ApiContracts.Posts
@inject IPostService PostService

<h3>Create post</h3>

<div class="mb-3">
    <label class="form-label">Title</label>
    <input class="form-control" @bind="title" @bind:event="oninput" />
</div>

<div class="mb-3">
    <label class="form-label">Body</label>
    <textarea class="form-control" rows="5" @bind="body" @bind:event="oninput"></textarea>
</div>

<button class="btn btn-primary" @onclick="CreateAsync">Create</button>

@if (!string.IsNullOrEmpty(message))
{
    <p class="mt-3">@message</p>
}

@code {
    [CascadingParameter] public Task<AuthenticationState> State { get; set; } = default!;

    private int userId;
    private string title = string.Empty;
    private string body = string.Empty;
    private string message = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        AuthenticationState authenticationState = await State;
        ClaimsPrincipal claimsPrincipal = authenticationState.User;
        if (claimsPrincipal.Identity is null || !claimsPrincipal.Identity.IsAuthenticated)
        {
            // the user is not logged in
            return;
        }
        string userIdAsString = claimsPrincipal.Claims.Single(c => c.Type == "Id").Value;
        userId = int.Parse(userIdAsString);
    }

    private async Task CreateAsync()
    {
        try
        {
            CreatePostDto dto = new()
            {
                Title = title,
                Body = body,
                AuthorUserId = userId
            };
            PostDto created = await PostService.AddPostAsync(dto);
            message = $"Created post '{created.Title}' with id {created.Id}";
        }
        catch (Exception e)
        {
            message = e.Message;
        }
    }
}