@page "/users/create"
@using ApiContracts.Users
@using BlazorApp.Services
@inject IUserService UserService

<h3>Create user</h3>
<div class="mb-3">
    <label class="form-label">Username</label>
    <input class="form-control" @bind="userName" @bind:event="oninput" />
</div>

<div class="mb-3">
    <label class="form-label">Password</label>
    <input class="form-control" type="password" @bind="password" @bind:event="oninput" />
</div>

<button class="btn btn-primary" @onclick="CreateAsync">Create</button>

@if (!string.IsNullOrEmpty(message))
{
    <p class="mt-3">@message</p>
}

@code {
    private string userName = string.Empty;
    private string password = string.Empty;
    private string message = string.Empty;
    
    private async Task CreateAsync()
    {
        try
        {
            CreateUserDto dto = new() { UserName = userName, Password = password };
            UserDto created = await UserService.AddUserAsync(dto);
            message = $"Created user '{created.UserName}' with id {created.Id}";
        }
        catch (Exception e)
        {
            message = e.Message;
        }
    }

}